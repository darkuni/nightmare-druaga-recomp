+            const uint32_t sHi = sLo + t.stackSize;
+            if (lo < sHi && sLo < hi)
+                return true;
+        }
+        return false;
+    };
+    uint32_t top = 0u;
+    for (int attempt = 0; attempt < 256; ++attempt)
+    {
+        top = m_runtime.reserveAsyncCallbackStack(kInvocationStackSize, 16u);
+        if (top == 0u || !overlapsThreadStack(top))
