diff --git a/ps2xRuntime/include/runtime/ee_scheduler.h b/ps2xRuntime/include/runtime/ee_scheduler.h
index f247ff9..ecbeb0b 100644
--- a/ps2xRuntime/include/runtime/ee_scheduler.h
+++ b/ps2xRuntime/include/runtime/ee_scheduler.h
@@ -420,6 +420,7 @@ private:
     int m_dmacTailOrder = 1000;
     uint32_t m_enabledIntcMask = 0xFFFFFFFFu;
     uint32_t m_enabledDmacMask = 0xFFFFFFFFu;
+    uint32_t m_pendingDmacMask = 0u; // DMAC causes raised while masked (D_STAT latch)
     int m_currentThreadId = 0;
     bool m_rescheduleRequested = false;
     bool m_timeSliceExpired = false;
diff --git a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
index c5e31c4..8b55ed4 100644
--- a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
+++ b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
@@ -1,3 +1,5 @@
+#include <cstdlib>
+#include <cstdio>
 #include "runtime/ee_scheduler.h"
 
 #include "ps2_log.h"
@@ -106,6 +108,7 @@ void EeScheduler::reset(uint8_t *rdram, const R5900Context &mainContext)
     m_dmacTailOrder = 1000;
     m_enabledIntcMask = 0xFFFFFFFFu;
     m_enabledDmacMask = 0xFFFFFFFFu;
+    m_pendingDmacMask = 0u;
     m_currentThreadId = 0;
     m_rescheduleRequested = false;
     m_timeSliceExpired = false;
@@ -1243,6 +1246,11 @@ int EeScheduler::setIrqCauseEnabled(bool dmac, uint32_t cause, bool enabled)
         if (enabled)
         {
             mask |= 1u << cause;
+            if (dmac && (m_pendingDmacMask & (1u << cause)) != 0u)
+            {
+                m_pendingDmacMask &= ~(1u << cause);
+                dispatchIrq(true, cause);
+            }
         }
         else
         {
@@ -1258,6 +1266,13 @@ void EeScheduler::dispatchIrq(bool dmac, uint32_t cause)
     const uint32_t mask = dmac ? m_enabledDmacMask : m_enabledIntcMask;
     if (cause < 32u && (mask & (1u << cause)) == 0u)
     {
+        // Real hardware latches the channel bit in D_STAT and raises the interrupt
+        // once the channel is re-enabled. Games bracket sceDmaSend with
+        // DisableDmac/EnableDmac, and our transfers finish synchronously inside it.
+        if (dmac)
+        {
+            m_pendingDmacMask |= 1u << cause;
+        }
         return;
     }
     const auto &handlers = dmac ? m_dmacHandlers : m_intcHandlers;
